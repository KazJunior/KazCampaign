# Configurações do Banco de Dados Neon (PostgreSQL)
# Obtenha sua Connection String no painel do Neon (https://console.neon.tech)
# Exemplo: postgresql://usuario:senha@ep-exemplo-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
KAZCAMPAIGN_DATABASE_URL=
# Ou DATABASE_URL / POSTGRES_URL fornecidas pela integração Neon na Vercel
DATABASE_URL=

# Segredo para assinatura de tokens de sessão (HMAC-SHA256)
# Gere uma chave aleatória e segura (ex: comando `openssl rand -base64 32`)
AUTH_SECRET=
